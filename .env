# Backend API Configuration
REACT_APP_API_BASE_URL=http://localhost:5000

# Fallback API URL (for production or alternative backend)
REACT_APP_API_FALLBACK_URL=https://salonn-backend.onrender.com

# Development server port (optional - React will use available port if not specified)
PORT=3000

# Auto-refresh interval for dashboard data (in milliseconds)
REACT_APP_REFRESH_INTERVAL=30000
